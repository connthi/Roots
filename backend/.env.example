PORT=4000

# Auth (change JWT_SECRET in production)
JWT_SECRET=your-random-secret-here
DATABASE_PATH=./data/store.json

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# AWS S3
S3_BUCKET_NAME=

# Set to true to test without AWS credentials (returns mock data)
DRY_RUN=false
